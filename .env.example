# ============================================================
#  Smart Farming Advice Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to source control.

# ----------------------------------------------------------
# IBM watsonx.ai Credentials
# ----------------------------------------------------------
# Your IBM Cloud API key (IAM key with watsonx.ai access)
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai platform URL (region-specific)
# US-South : https://us-south.ml.cloud.ibm.com
# EU-DE    : https://eu-de.ml.cloud.ibm.com
# JP-TOK   : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Your IBM Cloud project ID (found in watsonx.ai project settings)
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ----------------------------------------------------------
# Granite Model Selection
# ----------------------------------------------------------
# Recommended model — change to any available Granite variant
# ibm/granite-3-3-8b-instruct
# ibm/granite-3-8b-instruct
# ibm/granite-13b-chat-v2
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ----------------------------------------------------------
# Flask Application Settings
# ----------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
APP_NAME=Smart Farming Advice Agent
APP_VERSION=1.0.0

# Max tokens the model may generate per response
MAX_TOKENS=1024

# Model temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7
